# ---------------------------------------------------------------------------
# Voice CRM frontend. Copy to frontend/.env and restart `npm run dev`.
# WARNING: every VITE_* value is compiled into the browser bundle. Static SIP
# credentials here are for development/testing only (see README > Security).
# ---------------------------------------------------------------------------

# CRM backend (REST only - audio never goes through it).
# Leave empty to use the Vite dev proxy (/api -> http://localhost:8000).
VITE_API_BASE_URL=http://localhost:8000

# mock = simulated softphone (no PBX needed) | real = SIP.js over WSS to FreePBX
VITE_SIP_MODE=mock

# FreePBX on the local network (no VPN needed while on the same LAN).
# 8089 is FreePBX/Asterisk's default WSS port (Settings > Advanced > HTTP TLS).
VITE_SIP_WSS_URL=wss://192.168.1.222:8089/ws
VITE_SIP_DOMAIN=192.168.1.222
# Defaults to sip:<VITE_SIP_USERNAME>@<VITE_SIP_DOMAIN> when empty.
VITE_SIP_URI=

# WebRTC-enabled PJSIP extension (provided by the PBX owner - do not commit).
VITE_SIP_USERNAME=2002
VITE_SIP_PASSWORD=
VITE_SIP_DISPLAY_NAME=Voice CRM
# Only if the auth username differs from the extension number.
VITE_SIP_AUTHORIZATION_USERNAME=
# Optional custom Contact URI (user part is used).
VITE_SIP_CONTACT_URI=

# How dialed numbers are sent to FreePBX: raw | e164 | e164_no_plus | national
VITE_SIP_DIAL_FORMAT=raw
# Optional outbound route prefix (e.g. 9)
VITE_SIP_DIAL_PREFIX=
VITE_DEFAULT_COUNTRY_CODE=971

# ICE servers. Usually not needed on the same LAN.
VITE_STUN_URL=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
