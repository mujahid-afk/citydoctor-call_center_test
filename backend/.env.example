# Voice CRM backend. Copy to backend/.env.
# SIP/WebRTC credentials do NOT belong here: the softphone runs in the browser
# and its config lives in frontend/.env. FastAPI never carries audio.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Relative SQLite paths are resolved against the backend/ folder.
DATABASE_URL=sqlite:///./voice_crm.db
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Seed demo data automatically when the database is empty.
AUTO_SEED=true

# Optional: AI call summaries via Azure OpenAI / Azure AI Foundry (server-side only).
AZURE_API_KEY=
# Resource or Foundry project endpoint, e.g.
# https://<resource>.services.ai.azure.com/api/projects/<project>  (project path is stripped)
Azure_open_ai_endpoint=
# Deployment name in Azure AI Foundry (usually the model name).
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21
