# ---------------------------------------------------------------------------
# Voice CRM backend configuration
# Copy to backend/.env and adjust. Never commit the real .env file.
# Credentials stay on the backend; nothing here is ever sent to the frontend.
# ---------------------------------------------------------------------------

# --- Calling system mode ----------------------------------------------------
# mock       -> simulate calls locally (no real phone calls)
# vpn        -> call the existing internal calling system over VPN (HTTP API)
# elevenlabs -> optional: call the ElevenLabs outbound-call API directly
CALLING_SYSTEM_MODE=mock

# true forces mock mode regardless of CALLING_SYSTEM_MODE.
MOCK_CALLING_SYSTEM=true

# Seconds between simulated status steps (queued -> calling -> ringing -> answered -> completed).
MOCK_STEP_SECONDS=3

# --- Existing calling system reached over VPN (CALLING_SYSTEM_MODE=vpn) -----
# Base URL of the internal API in front of FreePBX / ElevenLabs, e.g. http://10.8.0.10:8080/api
CALLING_SYSTEM_BASE_URL=
# Sent as "Authorization: Bearer <key>" (and X-API-Key) on every request.
CALLING_SYSTEM_API_KEY=
# Paths appended to CALLING_SYSTEM_BASE_URL. {call_id} is replaced with the external call ID.
CALLING_SYSTEM_OUTBOUND_PATH=/calls/outbound
CALLING_SYSTEM_STATUS_PATH=/calls/{call_id}/status
CALLING_SYSTEM_DETAILS_PATH=/calls/{call_id}
CALLING_SYSTEM_HEALTH_PATH=/health
CALLING_SYSTEM_TIMEOUT=15
# Set to false only if the internal API uses a self-signed certificate.
CALLING_SYSTEM_VERIFY_TLS=true
# Optional shared secret the calling system/middleware sends as X-Webhook-Secret
# when posting events to /api/webhooks/calls.
CALLING_SYSTEM_WEBHOOK_SECRET=
# Internal FreePBX host on the VPN (informational + connectivity check), e.g. 10.8.0.5
VPN_INTERNAL_FREEPBX_HOST=

# --- ElevenLabs --------------------------------------------------------------
# Used to verify ElevenLabs post-call webhooks (ElevenLabs-Signature header).
ELEVENLABS_WEBHOOK_SECRET=
# Only needed for CALLING_SYSTEM_MODE=elevenlabs, conversation sync and audio download.
ELEVENLABS_API_KEY=
# Defaults used when a brand has no agent / phone number ID of its own.
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# sip_trunk (FreePBX SIP trunk numbers) or twilio
ELEVENLABS_OUTBOUND_TRANSPORT=sip_trunk
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# --- App --------------------------------------------------------------------
# Defaults to backend/voice_crm.db when empty.
DATABASE_URL=
# Seed demo data automatically when the database is empty.
AUTO_SEED=true
# Comma separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional shared secret for /api/tools/* (sent as X-Tools-Key header).
TOOLS_API_KEY=
